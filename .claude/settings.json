{
      "enabledPlugins": {
        "frontend-design@claude-plugins-official": true
      },
      "hooks": {
        "PreToolUse": [
          {
            "matcher": "Bash",
            "hooks": [
              {
                "type": "command",
                "command": "case \"$CLAUDE_TOOL_INPUT\" in *'git commit'*) bun run lint && bunx tsc --noEmit ;; esac"
              }
            ]
          }
        ]
      },
      "permissions": {
        "deny": [
          "Read(.env)",
          "Read(.env.local)",
          "Read(.env.*)",
          "Read(*.pem)",
          "Read(*.key)",
          "Read(*.p12)",
          "Read(*.pfx)",
          "Read(.netrc)",
          "Read(**/*secret*)",
          "Read(**/*credential*)",
          "Read(**/*password*)",
          "Read(.aws/credentials)",
          "Read(.ssh/*)"
        ]
      }
    }